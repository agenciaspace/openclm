# Run python3 scripts/configure.py to create .env with unique secrets.
APP_URL=http://localhost:8000
SECURE_COOKIES=false
DATABASE_URL=sqlite:///./openclm.db
POSTGRES_PASSWORD=
TOKEN_ENCRYPTION_KEY=

# Optional local AI. Docker Compose overrides the URL to http://ollama:11434.
AI_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Configure ONCE per self-hosted installation. Users then click Connect with DocuSign.
# Register APP_URL/api/v1/integrations/docusign/callback as an OAuth redirect URI.
DOCUSIGN_ENABLED=false
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_CLIENT_SECRET=
# Integrator-managed HMAC key from the application owner's DocuSign account.
DOCUSIGN_HMAC_SECRET=

# Salesforce External Client App (sandbox first)
SALESFORCE_ENABLED=false
SALESFORCE_LOGIN_URL=https://test.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
